{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, business_id, name, product_type, description, quantity, unit, price,\n                   expiry_date, batch_id, image_path, qr_token, qr_path, is_active, is_deleted,\n                   created_at, updated_at\n            FROM   products\n            WHERE  business_id    = $1\n              AND  is_deleted = FALSE\n              AND  ($2 = '' OR product_type ILIKE $2)\n              AND  ($3 = '' OR name ILIKE '%' || $3 || '%')\n              AND  (NOT $4    OR is_active = TRUE)\n            ORDER  BY created_at DESC\n            LIMIT  $5 OFFSET $6\n            ",
