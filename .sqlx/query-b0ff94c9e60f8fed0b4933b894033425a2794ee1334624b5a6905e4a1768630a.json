  "query": "\n            UPDATE products SET\n                name         = $1,\n                product_type = $2,\n                description  = $3,\n                quantity     = $4,\n                unit         = $5,\n                price        = $6,\n                batch_id     = $7,\n                is_active    = $8\n            WHERE id = $9 AND business_id = $10 AND is_deleted = FALSE\n            RETURNING id, business_id, name, product_type, description, quantity, unit, price,\n                      batch_id, image_path, qr_token, qr_path, is_active, is_deleted,\n                      created_at, updated_at\n            ",
