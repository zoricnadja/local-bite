  "query": "\n            SELECT id, farm_id, name, product_type, description, quantity, unit, price,\n                   expiry_date, batch_id, image_path, qr_token, qr_path, is_active, is_deleted,\n                   created_at, updated_at\n            FROM   products\n            WHERE  qr_token  = $1\n              AND  is_active = TRUE\n              AND  is_deleted = FALSE\n            ",
